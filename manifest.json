{
  "manifest_version": 3,
  "name": "AI Asli: AI Text, Image and Video Checker",
  "short_name": "AI Asli",
  "version": "1.4.0",
  "description": "Spots text, images and videos likely made with AI, checks Content Credentials, and explains why. Runs on your device.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Asli: check this page for AI-made content",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan this page"
    }
  },
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/suhaimizainalshah/ai-asli",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "omnibox": {
    "keyword": "asli"
  }
}